# Dataset: 220 MB archive, ~1.8 GB extracted. Distributed via GitHub Releases, downloaded
# by section 3. data/external/ caches the third-party sources fetched at build time.
data/

# Generated by a notebook run.
artifacts/

# Environment
venv/
.venv/
__pycache__/
*.py[cod]
*.egg-info/

# Jupyter. Notebook outputs are stripped by the nbstripout clean filter (.gitattributes),
# which a fresh clone activates with: ./venv/bin/nbstripout --install
.ipynb_checkpoints/

# pytest
.pytest_cache/

# CatBoost training logs, written to cwd by default
catboost_info/

# Raw HTTP responses cached by the one-off live-listing scan script -- may contain scraped
# third-party content and should not be committed.
scripts/live_flip_scan/cache/

# Full HTML export of the notebook, outputs included -- outputs are kept out of git via
# nbstripout (see above), so a baked-in export shouldn't be committed either.
london-flip-finder.html
